<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local audio access only. Lowspin never requests network access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 15 & 16 Live Updates / Promoted Ongoing Notifications -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- OnePlus OxygenOS 15 background service protection -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Background playback on Android 14+ & 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- OnePlus OxygenOS 15 & ColorOS 15 Fluid Cloud / Pantanal service permissions -->
    <uses-permission android:name="com.oplus.permission.safe.ASSISTANT" />
    <uses-permission android:name="com.oplus.permission.safe.PANTANAL" />
    <uses-permission android:name="com.oplus.permission.safe.BACKGROUND" />

    <!-- Hard offline lock: strip network permissions even if a dependency adds them. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".LowspinApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lowspin">

        <meta-data android:name="oplus.pantanal.support" android:value="true" />
        <meta-data android:name="com.oplus.pantanal.support" android:value="true" />
        <meta-data android:name="com.oplus.pantanal.capsule.support" android:value="true" />
        <meta-data android:name="oplus.capsule.support" android:value="true" />
        <meta-data android:name="com.oplus.livealert.support" android:value="true" />
        <meta-data android:name="oplus.livealert.support" android:value="true" />
        <meta-data android:name="com.oplus.fluidcloud.support" android:value="true" />
        <meta-data android:name="oplus.fluidcloud.support" android:value="true" />

        <!-- OxygenOS 15 / ColorOS: request unrestricted background launch -->
        <meta-data
            android:name="oplus.startUpType"
            android:value="2" />
        <meta-data
            android:name="com.coloros.pushsdk.permission.STARTINFO"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|fontScale|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Lowspin.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BubbleActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|fontScale|uiMode"
            android:exported="true"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Lowspin">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name=".media.ArtworkProvider"
            android:authorities="com.lowspin.app.art"
            android:exported="true"
            android:grantUriPermissions="true" />

        <service
            android:name=".media.HighSpinQsTile"
            android:label="HighSpin"
            android:icon="@drawable/ic_stat_vinyl"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".media.PlaybackAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".media.HighSpinWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/highspin_widget_info" />
        </receiver>
    </application>

</manifest>
